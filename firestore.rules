rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Function to check if the user is the master admin
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'spantech121@gmail.com';
    }

    // Products Collection
    match /products/{productId} {
      allow read: if true; // Anyone can view products
      allow write: if isAdmin(); // Only admin can add, update, or delete products
    }

    // Users Collection
    match /users/{userId} {
      // Admins can read all users
      // Users can only read their own document (based on email)
      allow read: if isAdmin() || (request.auth != null && request.auth.token.email == resource.data.email);
      
      // Users can create/update their own profile
      allow create, update: if request.auth != null && request.auth.token.email == request.resource.data.email;
      
      // Only admins can delete users
      allow delete: if isAdmin();
    }

    // Quotations Collection
    match /quotations/{quoteId} {
      // Admins can read all quotations, users can read their own
      allow read: if isAdmin() || (request.auth != null && request.auth.token.email == resource.data.email);
      
      // Any logged-in user can submit a quotation
      allow create: if request.auth != null;
      
      // Only admins can update or delete quotes
      allow update, delete: if isAdmin();
    }
  }
}
